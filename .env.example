# ─────────────────────────────────────────────────────────────────────────────
# Cloud Sync = Firebase Firestore (لا PostgreSQL ولا DATABASE_URL)
# انسخ هذا الملف إلى .env.local واملأ القيم من Firebase Console:
#   Project settings → Service accounts → Generate new private key
# ─────────────────────────────────────────────────────────────────────────────

# الخيار 1 (موصى به للاستضافة): JSON كامل لحساب الخدمة في سطر واحد، أو نفس الـJSON مُرمّزًا base64
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# الخيار 2: متغيرات منفصلة (لاحظ \n داخل المفتاح الخاص)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# الخيار 3: Application Default Credentials (Cloud Run / GCE / gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# الخيار 4: محاكي Firestore للتطوير المحلي (firebase emulators:start --only firestore)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-the-knight-app

# اختياري: قاعدة Firestore غير الافتراضية
# FIREBASE_DATABASE_ID=(default)

# اختياري: تخصيص أسماء المجموعات
# FIRESTORE_ACCOUNTS_COLLECTION=accounts
# FIRESTORE_ACCOUNT_CODES_COLLECTION=accountCodes
# FIRESTORE_AI_AUDIT_COLLECTION=aiAuditLog

# ─── مزوّد الذكاء الاصطناعي (اختياري) ─────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
